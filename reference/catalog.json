{
  "schemaVersion": "1.0.0",
  "package": "@konitif/workbench",
  "intent": "Provide the contracts and authorities of a composable work environment independently of its UI projections.",
  "clusters": [
    {
      "id": "runtime-domain",
      "title": "Runtime authority",
      "summary": "Lifecycle, plans, checkpoints, observations, suspension, and resumption of a Workbench execution.",
      "authority": "Canonical runtime session state, distinct from the executed definition and its projections.",
      "owns": [
        "runtime sessions",
        "lifecycle transitions",
        "correlated observations"
      ],
      "doesNotOwn": [
        "authored composition",
        "workspace layout",
        "external physical effect"
      ],
      "workflow": [
        "Admit",
        "Execute",
        "Observe",
        "Resume"
      ],
      "sourcePrefixes": [
        "domain/runtime/"
      ]
    },
    {
      "id": "composition-domain",
      "title": "Executable composition",
      "summary": "Canonical plans and assemblies that describe what can be executed independently of their editor.",
      "authority": "Versioned, commandable composition artifact.",
      "owns": [
        "executable structure",
        "semantic revision",
        "dependencies"
      ],
      "doesNotOwn": [
        "visual positions",
        "runtime session",
        "derived result"
      ],
      "workflow": [
        "Declare",
        "Validate",
        "Version",
        "Derive"
      ],
      "sourcePrefixes": [
        "domain/composition/"
      ]
    },
    {
      "id": "workspace-layout-domain",
      "title": "Workspace and layout",
      "summary": "Organization of surfaces, panels, zones, and spatial interactions in a work environment.",
      "authority": "Workspace configuration, separate from the meaning of open subjects.",
      "owns": [
        "layout tree",
        "panels",
        "modes and preferences"
      ],
      "doesNotOwn": [
        "executed composition",
        "internal tool state"
      ],
      "workflow": [
        "Compose",
        "Arrange",
        "Persist",
        "Rehydrate"
      ],
      "sourcePrefixes": [
        "domain/workspace/",
        "domain/layout/",
        "domain/panel/",
        "domain/workbench/"
      ]
    },
    {
      "id": "extensions-domain",
      "title": "Tools, widgets, and surfaces",
      "summary": "Extension contracts that let the Workbench host capabilities without owning them.",
      "authority": "Admission and resolution of portable contributions.",
      "owns": [
        "extension contracts",
        "contribution identities",
        "required capabilities"
      ],
      "doesNotOwn": [
        "hosted domain implementation",
        "concrete UI rendering"
      ],
      "workflow": [
        "Define",
        "Register",
        "Resolve",
        "Host"
      ],
      "sourcePrefixes": [
        "domain/tool/",
        "domain/widget/",
        "domain/surface/"
      ],
      "symbolNames": [
        "createWorkbenchWidgetAdapter",
        "WorkbenchWidgetHosting"
      ]
    },
    {
      "id": "project-launch-domain",
      "title": "Project, launch, and repository",
      "summary": "Contracts for identifying, preflighting, qualifying, and admitting a project into the Workbench.",
      "authority": "Project admission decision and associated diagnostics.",
      "owns": [
        "project manifests",
        "launch steps",
        "repository diagnostics"
      ],
      "doesNotOwn": [
        "repository content",
        "proof of general validity"
      ],
      "workflow": [
        "Identify",
        "Inspect",
        "Qualify",
        "Admit"
      ],
      "sourcePrefixes": [
        "domain/project/",
        "domain/launch/",
        "domain/repository/",
        "domain/repo-quality/"
      ]
    },
    {
      "id": "temporal-physics-domain",
      "title": "Time, physics, and input",
      "summary": "Coordinate, history, physics calculation, and input contracts used by hosted capabilities.",
      "authority": "Shared calculation and coordination models without ownership of external hardware.",
      "owns": [
        "temporal coordinates",
        "physics models",
        "input intents"
      ],
      "doesNotOwn": [
        "system clock",
        "external physical subject",
        "device"
      ],
      "workflow": [
        "Describe",
        "Calculate",
        "Sample",
        "Observe"
      ],
      "sourcePrefixes": [
        "domain/temporal/",
        "domain/physics/",
        "domain/input/"
      ]
    },
    {
      "id": "presentation-foundations",
      "title": "Presentation foundations",
      "summary": "Language, icons, design system, shell, and presentation metadata independent of components.",
      "authority": "Presentation contracts consumable by multiple projections.",
      "owns": [
        "descriptors",
        "translations",
        "visual identities"
      ],
      "doesNotOwn": [
        "DOM",
        "Svelte components",
        "business state"
      ],
      "workflow": [
        "Declare",
        "Resolve",
        "Project"
      ],
      "sourcePrefixes": [
        "domain/i18n/",
        "domain/icon/",
        "domain/design-system/",
        "domain/presentation/",
        "domain/shell/",
        "domain/shared/"
      ]
    },
    {
      "id": "workspace-application",
      "title": "Workspace application",
      "summary": "Use cases for composing and manipulating workspaces.",
      "authority": "Application orchestration of the workspace.",
      "owns": [
        "command routing",
        "sessions",
        "snapshots"
      ],
      "doesNotOwn": [
        "domain model",
        "UI components"
      ],
      "workflow": [
        "Receive",
        "Coordinate",
        "Project"
      ],
      "sourcePrefixes": [
        "application/workspace/",
        "application/layout/",
        "application/shell/"
      ]
    },
    {
      "id": "runtime-application",
      "title": "Runtime application",
      "summary": "Plans, observations, checkpoints, and offload for the Workbench runtime.",
      "authority": "Observable runtime coordination.",
      "owns": [
        "plans",
        "checkpoints",
        "observability"
      ],
      "doesNotOwn": [
        "external business effect"
      ],
      "workflow": [
        "Plan",
        "Execute",
        "Observe"
      ],
      "sourcePrefixes": [
        "application/runtime/"
      ]
    },
    {
      "id": "registries-and-project",
      "title": "Project and registries",
      "summary": "Manifests and registries that resolve available capabilities.",
      "authority": "Application-level admission and resolution.",
      "owns": [
        "manifests",
        "registries",
        "translations"
      ],
      "doesNotOwn": [
        "registered implementations"
      ],
      "workflow": [
        "Declare",
        "Register",
        "Resolve"
      ],
      "sourcePrefixes": [
        "application/project/",
        "application/registry/",
        "application/i18n/"
      ]
    },
    {
      "id": "experiments-and-preflight",
      "title": "Experiments and preflight",
      "summary": "Controlled campaigns, observation recording, and preliminary repository verification.",
      "authority": "Explicit experiment protocol and preflight decision.",
      "owns": [
        "campaigns",
        "experimental observations",
        "repository diagnostics"
      ],
      "doesNotOwn": [
        "general scientific result",
        "repository content"
      ],
      "workflow": [
        "Prepare",
        "Execute",
        "Record"
      ],
      "sourcePrefixes": [
        "application/experiment/",
        "application/repository/",
        "domain/experiment/"
      ]
    },
    {
      "id": "infrastructure",
      "title": "Infrastructure",
      "summary": "Replaceable persistence and communication adapters.",
      "authority": "Port implementation, not domain authority.",
      "owns": [
        "adapters",
        "transport",
        "storage"
      ],
      "doesNotOwn": [
        "business rules"
      ],
      "workflow": [
        "Adapt",
        "Transmit",
        "Restore"
      ],
      "sourcePrefixes": [
        "infrastructure/"
      ]
    },
    {
      "id": "temporal",
      "title": "Temporal structures",
      "summary": "Workbench compatibility contracts over the independent temporal layer.",
      "authority": "Shared temporal model.",
      "owns": [
        "coordinates",
        "dialects",
        "projections"
      ],
      "doesNotOwn": [
        "external clock"
      ],
      "workflow": [
        "Declare",
        "Resolve",
        "Project"
      ],
      "sourcePrefixes": [
        "temporal/"
      ]
    },
    {
      "id": "boot-and-stage",
      "title": "Initialization and staging",
      "summary": "Prepares a session and its changes before admission.",
      "authority": "Reversible preparation.",
      "owns": [
        "boot",
        "preflight",
        "staging"
      ],
      "doesNotOwn": [
        "committed state"
      ],
      "workflow": [
        "Prepare",
        "Verify",
        "Admit"
      ],
      "sourcePrefixes": [
        "boot/",
        "stage/"
      ]
    }
  ]
}
